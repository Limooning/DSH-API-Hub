{
  "name": "dsh-api-hub",
  "version": "0.3.1",
  "description": "API Hub — manage and call local API providers (keys, models, balances) and skills from inside DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "api", "dashboard", "balance"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./server": "./lib/server.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "providers.example.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
