{
  "name": "dsh-api-hub",
  "version": "0.7.8",
  "description": "API Hub — manage and call local API providers (keys, models, balances) and skills from inside DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Limooning/DSH-API-Hub.git"
  },
  "homepage": "https://github.com/Limooning/DSH-API-Hub#readme",
  "bugs": {
    "url": "https://github.com/Limooning/DSH-API-Hub/issues"
  },
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "scripts": {
    "test": "node --test test/smoke.test.mjs",
    "check:dsh": "node scripts/check-dsh-compat.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "assets/icon.svg",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "api", "dashboard", "balance"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./server": "./lib/server.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "providers.example.json",
    "LICENSE",
    "docs/screenshot.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
